# Cloudflare API token for Traefik's Let's Encrypt DNS-01 resolver.
# Permissions: Zone DNS Edit + Zone Read for all managed zones
# (musfiqdehan.com including *.ecamp.musfiqdehan.com, mrdfit.uk, mrderp.uk,
# mrdhrms.uk, mrdlms.uk). Required for nested subdomain wildcards such as
# client1.ecamp.musfiqdehan.com (origin certs only cover one DNS label).
CF_DNS_API_TOKEN=replace-with-cloudflare-api-token

# Grafana admin login (https://grafana.musfiqdehan.com — also behind Traefik basic auth).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
